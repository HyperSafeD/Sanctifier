        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (route) (rate(sanctifier_http_request_errors_total{job=~\"$job\", instance=~\"$instance\", route=~\"$route\"}[$__rate_interval])) or 0 * sum by (route) (rate(sanctifier_http_requests_total{job=~\"$job\", instance=~\"$instance\", route=~\"$route\"}[$__rate_interval]))) / clamp_min(sum by (route) (rate(sanctifier_http_requests_total{job=~\"$job\", instance=~\"$instance\", route=~\"$route\"}[$__rate_interval])), 1e-9)",
